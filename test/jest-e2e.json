{
  "moduleFileExtensions": ["js", "json", "ts", "mjs"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testTimeout": 30000,
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.(t|j|mj)s$": [
      "ts-jest",
      {
        "useESM": false,
        "tsconfig": {
          "target": "ES2022",
          "module": "commonjs",
          "moduleResolution": "node",
          "resolvePackageJsonExports": false,
          "allowJs": true,
          "esModuleInterop": true
        }
      }
    ]
  },
  "transformIgnorePatterns": []
}
