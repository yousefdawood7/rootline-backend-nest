# Application Environment
NODE_ENV=development
PORT=3000

# Database (Neon Serverless PostgreSQL / Local PostgreSQL)
# Pooled connection string used by the application runtime
DATABASE_URL=postgresql://rootline_user:rootline_password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Direct unpooled connection string used exclusively by Prisma CLI for migrations
DATABASE_URL_UNPOOLED=postgresql://rootline_user:rootline_password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication Secrets (minimum 32 characters each)
JWT_ACCESS_SECRET=super_secret_jwt_access_token_key_change_in_production_123456
JWT_REFRESH_SECRET=super_secret_jwt_refresh_token_key_change_in_production_123456
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (Comma-separated allowed origins; required in production)
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
